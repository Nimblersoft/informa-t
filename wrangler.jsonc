{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "informa-t",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "informa-t.nimblersoft.com",
      "custom_domain": true
    }
  ],
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "informa-t-audit",
      "database_id": "bdf3cf9a-fbb6-41d9-a571-42cd4a763cb8",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
