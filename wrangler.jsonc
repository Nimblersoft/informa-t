{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "informa-t",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ]
}

